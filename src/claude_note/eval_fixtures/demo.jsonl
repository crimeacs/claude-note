# Hand-written labels for docs/examples/recall-demo/vault (index it as collection "notes").
# Two questions per note: one in the asker's likely words, one worded unlike the note. Off-topic
# questions (expect []) must not inject anything. Split is fixed so dev and test never share a note.
{"id": "build-1", "question": "Can I just run npm run build on the 4 GB box?", "expect": ["never-build-on-a-small-box"], "split": "dev"}
{"id": "build-2", "question": "The production server keeps dying with heap out of memory whenever we compile the Next app there", "expect": ["never-build-on-a-small-box"], "split": "dev"}
{"id": "oauth-1", "question": "Gmail calls fail with 403 since I added the Calendar scope", "expect": ["google-oauth-new-scope-needs-reconsent"], "split": "test"}
