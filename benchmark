def bench_system(api_url, qmd_url):
    """Check that all services are up and responding correctly."""
    results = []
    p = Progress("system", 6)

    # 1. claude-note API health
    p.update("GET /health")
    status, body, ms = http_get(f"{api_url}/health")
    ok = status == 200 and isinstance(body, dict) and body.get("status") == "ok"
    r = BenchmarkResult(
        name="api_health",
        passed=ok,
        details={
            "status_code": status,
            "response": body,
            "latency_ms": round(ms, 2),
        },
    )
    results.append(r)
    p.log_result("api_health", ok, f"{ms:.0f}ms")

    # 2. claude-note worker alive
    p.update("worker thread")
    worker_alive = isinstance(body, dict) and body.get("worker_alive", False)
    results.append(BenchmarkResult(
        name="api_worker_alive",
        passed=worker_alive,
        details={"worker_alive": worker_alive},
    ))
    p.log_result("api_worker_alive", worker_alive)

    # 3. claude-note API /status
    p.update("GET /status")
    status, body, ms = http_get(f"{api_url}/status")
    ok = status == 200 and isinstance(body, dict) and "sessions" in body
    results.append(BenchmarkResult(
        name="api_status",
        passed=ok,
        details={
            "status_code": status,
            "response": body if ok else str(body)[:200],
            "latency_ms": round(ms, 2),
        },
    ))
    p.log_result("api_status", ok, f"{ms:.0f}ms")

    # 4. QMD health
    p.update("QMD /health")
    status, body, ms = http_get(f"{qmd_url}/health")
    qmd_ok = status == 200 and isinstance(body, dict) and body.get("ok", False)
    results.append(BenchmarkResult(
        name="qmd_health",
        passed=qmd_ok,
        details={
            "status_code": status,
            "response": body,
            "latency_ms": round(ms, 2),
        },
    ))
    p.log_result("qmd_health", qmd_ok, f"{ms:.0f}ms")

    # 5. QMD status (index info)
    p.update("QMD /status")
    status, body, ms = http_get(f"{qmd_url}/status")
    results.append(BenchmarkResult(
        name="qmd_status",
        passed=status == 200,
        details={
            "status_code": status,
            "response": body if status == 200 else str(body)[:200],
            "latency_ms": round(ms, 2),
        },
    ))
    p.log_result("qmd_status", status == 200, f"{ms:.0f}ms")

    # 6. Event enqueue round-trip
    p.update("POST /events")
    test_sid = f"bench-system-{int(time.time())}"
    status, body, ms = http_post(f"{api_url}/events", {
        "session_id": test_sid,
