# ── Data structures ──────────────────────────────────────────────────────────


@dataclass
class Timing:
    """Collected latency measurements for a single benchmark."""
    name: str
    values_ms: list = field(default_factory=list)
    errors: list = field(default_factory=list)
    metadata: dict = field(default_factory=dict)

    @property
    def success_count(self) -> int:
        return len(self.values_ms)

    @property
    def error_count(self) -> int:
        return len(self.errors)

    @property
    def total(self) -> int:
        return self.success_count + self.error_count

    def add(self, ms: float):
        self.values_ms.append(ms)

    def add_error(self, err: str):
        self.errors.append(err)


@dataclass
class BenchmarkResult:
    """Result of a single benchmark."""
    name: str
    passed: bool
    timing: Optional[Timing] = None
    details: dict = field(default_factory=dict)
    sub_results: list = field(default_factory=list)


# ── Progress display ────────────────────────────────────────────────────────

# ANSI color codes
DIM = "\033[2m"
RESET = "\033[0m"
GREEN = "\033[32m"
RED = "\033[31m"
CYAN = "\033[36m"
YELLOW = "\033[33m"
BOLD = "\033[1m"
CLEAR_LINE = "\033[2K"

_quiet = False  # set True for --json mode


class Progress:
    """Live progress bar and per-test logging for benchmark suites."""

    def __init__(self, suite_name, total_steps):
        self.suite = suite_name
        self.total = total_steps
        self.current = 0
        self.t_start = time.monotonic()
        self._cols = shutil.get_terminal_size((80, 24)).columns

    def _bar(self, width=30):
        filled = int(width * self.current / self.total) if self.total else 0
        bar = "█" * filled + "░" * (width - filled)
        pct = int(100 * self.current / self.total) if self.total else 0
        return f"{bar} {pct:3d}%"

    def _elapsed(self):
        s = time.monotonic() - self.t_start
        if s < 60:
            return f"{s:.0f}s"
        return f"{int(s)//60}m{int(s)%60:02d}s"

    def step(self, label=""):
        """Advance progress counter by one major step."""
        self.current = min(self.current + 1, self.total)
        self.spin(label)

    def spin(self, label):
        """Update display label without advancing counter (for sub-iterations)."""
        if _quiet:
            return
        line = f"  {CYAN}{self.suite}{RESET} {self._bar()} {DIM}{self.current}/{self.total}{RESET} {label}"
        # truncate to terminal width
        if len(line) > self._cols + 30:  # account for ANSI codes
            line = line[:self._cols + 26] + "…"
        sys.stderr.write(f"\r{CLEAR_LINE}{line}")
        sys.stderr.flush()

    def update(self, label):
        """Alias for step() — advances counter and shows label."""
        self.step(label)

    def log(self, msg):
        """Print a log line (clears progress bar, then redraws)."""
        if _quiet:
            return
        sys.stderr.write(f"\r{CLEAR_LINE}  {DIM}│{RESET} {msg}\n")
        sys.stderr.flush()

    def log_result(self, name, passed, detail=""):
        """Log a single test result inline."""
        if _quiet:
            return
        icon = f"{GREEN}✓{RESET}" if passed else f"{RED}✗{RESET}"
        suffix = f"  {DIM}{detail}{RESET}" if detail else ""
        sys.stderr.write(f"\r{CLEAR_LINE}  {icon} {name}{suffix}\n")
        sys.stderr.flush()

    def done(self):
        """Clear progress bar when suite is complete."""
        if _quiet:
            return
        sys.stderr.write(f"\r{CLEAR_LINE}  {CYAN}{self.suite}{RESET} done ({self._elapsed()})\n")
        sys.stderr.flush()

    def iter(self, label, n, callback):
        """Run callback n times with inline progress counter."""
        if _quiet:
            for i in range(n):
                callback(i)
            return
        for i in range(n):
            line = f"  {CYAN}{self.suite}{RESET} {self._bar()} {label} {DIM}[{i+1}/{n}]{RESET}"
            sys.stderr.write(f"\r{CLEAR_LINE}{line}")
            sys.stderr.flush()
            callback(i)


# ── Statistics helpers ───────────────────────────────────────────────────────


def percentile(data, p):
    """Compute p-th percentile (0-100) using linear interpolation."""
    if not data:
        return 0.0
    s = sorted(data)
    n = len(s)
    k = (p / 100.0) * (n - 1)
    f = int(k)
    c = min(f + 1, n - 1)
    return s[f] + (k - f) * (s[c] - s[f])


def iqr_outliers(data):
    """Split data into (clean, outliers) using IQR method."""
    if len(data) < 4:
        return list(data), []
    q1 = percentile(data, 25)
    q3 = percentile(data, 75)
    iqr = q3 - q1
    lo = q1 - 1.5 * iqr
    hi = q3 + 1.5 * iqr
    clean = [x for x in data if lo <= x <= hi]
    outliers = [x for x in data if x < lo or x > hi]
    return clean, outliers


def confidence_interval_95(data):
    """95% CI for the mean (normal approximation)."""
    if len(data) < 2:
        return (0.0, 0.0)
    n = len(data)
    mean = statistics.mean(data)
    se = statistics.stdev(data) / math.sqrt(n)
    return (mean - 1.96 * se, mean + 1.96 * se)


def format_stats(data):
    """Compute full stats dict for a list of ms values."""
    if not data:
        return {"n": 0}
    clean, outliers = iqr_outliers(data)
    ci_lo, ci_hi = confidence_interval_95(clean) if len(clean) >= 2 else (0, 0)
    cv = (statistics.stdev(clean) / statistics.mean(clean) * 100) if len(clean) >= 2 and statistics.mean(clean) > 0 else 0
    return {
        "n": len(data),
        "n_clean": len(clean),
        "outliers": len(outliers),
        "min": round(min(data), 2),
        "p50": round(percentile(data, 50), 2),
        "p90": round(percentile(data, 90), 2),
        "p95": round(percentile(data, 95), 2),
        "p99": round(percentile(data, 99), 2),
        "max": round(max(data), 2),
        "mean": round(statistics.mean(clean), 2),
        "stdev": round(statistics.stdev(clean), 2) if len(clean) >= 2 else 0,
        "ci95": [round(ci_lo, 2), round(ci_hi, 2)],
        "cv_pct": round(cv, 1),
    }


def estimate_tokens(text):
    """Estimate token count using segmented char-based heuristic.

    Approximation tuned for cl100k_base-family tokenizers (Claude / GPT-4).
    Code tokenizes at ~3.2 chars/token, prose at ~4.0, newlines ~0.5 each.
    """
    code_blocks = re.findall(r"```[\s\S]*?```", text)
    code_chars = sum(len(b) for b in code_blocks)
    prose_chars = len(text) - code_chars
    newlines = text.count("\n")
    return int(code_chars / 3.2 + prose_chars / 4.0 + newlines * 0.5)


# ── HTTP helpers ─────────────────────────────────────────────────────────────


def http_get(url, timeout=TIMEOUT):
    """GET request. Returns (status, body, elapsed_ms)."""
    t0 = time.monotonic()
    try:
        req = urllib.request.Request(url)
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read()
            elapsed = (time.monotonic() - t0) * 1000
            try:
                return resp.status, json.loads(raw), elapsed
            except json.JSONDecodeError:
                return resp.status, raw.decode(errors="replace"), elapsed
    except urllib.error.HTTPError as e:
        elapsed = (time.monotonic() - t0) * 1000
        body = e.read().decode(errors="replace")[:500]
        return e.code, {"error": body}, elapsed
    except Exception as e:
        elapsed = (time.monotonic() - t0) * 1000
        return 0, {"error": str(e)}, elapsed


def http_post(url, body, timeout=TIMEOUT):
    """POST JSON request. Returns (status, body, elapsed_ms)."""
    t0 = time.monotonic()
    try:
        data = json.dumps(body).encode()
        req = urllib.request.Request(
            url, data=data,
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read()
            elapsed = (time.monotonic() - t0) * 1000
            try:
                return resp.status, json.loads(raw), elapsed
            except json.JSONDecodeError:
                return resp.status, raw.decode(errors="replace"), elapsed
    except urllib.error.HTTPError as e:
        elapsed = (time.monotonic() - t0) * 1000
        body_str = e.read().decode(errors="replace")[:500]
        return e.code, {"error": body_str}, elapsed
    except Exception as e:
        elapsed = (time.monotonic() - t0) * 1000
        return 0, {"error": str(e)}, elapsed


